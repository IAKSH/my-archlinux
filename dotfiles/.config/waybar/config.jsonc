{
    "include": [
        "~/.config/waybar/modules.jsonc"
    ],
    "layer": "top",
    "position": "top",
    "height": 25,
    "fixed-center": true,
    "reload_style_on_change": true,
    "spacing": 4,
    "modules-left": [
        "hyprland/workspaces",
        "mpris",
        "custom/media"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "group/network",
        "group/status",
        "group/audio",
        "group/apps",
        "clock"
    ],
}
